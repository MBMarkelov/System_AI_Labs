<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaUI.ViewModels.AuntificationModel;assembly=AvaloniaUI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaUI.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Авторизация пользователя" Width="300" Height="200">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Авторизация пользователя" FontSize="16" HorizontalAlignment="Center"/>
        <TextBox Watermark="Номер телефона" Text="{Binding PhoneNumber}"/>
        <Button Content="Войти" Command="{Binding LoginCommand}"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"/>
    </StackPanel>
</Window>